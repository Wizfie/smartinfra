      <!-- ════════════════════════════════════════════════════════════════ -->
      <!-- 02. ACTIVITY MODEL (SINKRON 100% DENGAN GAMBAR 3.2 & 3.3)       -->
      <!-- ════════════════════════════════════════════════════════════════ -->
      <packagedElement xmi:type="uml:Package" xmi:id="EAID_PKG_ACT" name="02. Activity Model" visibility="public">
        
        <!-- Activity 1: Rekomendasi SPK SAW -->
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_ACTV_SPK" name="Activity: Rekomendasi SPK SAW" visibility="public">
          <node xmi:type="uml:InitialNode" xmi:id="EAID_NODE_ACTV_01" name="Start"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_02" name="1. Memilih Persona Profil Kebutuhan (Mahasiswa, Gamer, Desainer)"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_03" name="2. Menentukan Batas Filter Tambahan (Harga Max, Min RAM, Brand)"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_04" name="3. Query Data Laptop Ready Stock dari Database (Matriks X)"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_05" name="4. Normalisasi Matriks Keputusan R (Formula Benefit &amp; Cost SAW)"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_06" name="5. Kalkulasi Nilai Preferensi V_i = sum(w_j * r_ij) &amp; Match %"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_07" name="6. Perangkingan Alternatif (Sorting Descending V_i Tertinggi)"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_08" name="7. Menampilkan Halaman Rekomendasi Laptop Terbaik"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_ACTV_09" name="8. Pembeli Memilih: Checkout Mandiri / Simulasi Kredit"/>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="EAID_NODE_ACTV_10" name="End"/>
        </packagedElement>

        <!-- Activity 2: Assisted Checkout & Maker-Checker Approval (Swimlanes) -->
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_ACTV_ASSISTED" name="Activity: Assisted Checkout &amp; Maker-Checker Approval" visibility="public">
          <!-- Swimlanes / Partitions -->
          <group xmi:type="uml:ActivityPartition" xmi:id="EAID_LANE_CUST" name="Konsumen (Customer)"/>
          <group xmi:type="uml:ActivityPartition" xmi:id="EAID_LANE_SALES" name="Sales Consultant (Maker)"/>
          <group xmi:type="uml:ActivityPartition" xmi:id="EAID_LANE_ADMIN" name="Administrator / Kasir (Checker)"/>

          <node xmi:type="uml:InitialNode" xmi:id="EAID_NODE_AC_01" name="Start" inPartition="EAID_LANE_CUST"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_02" name="Konsumen Konsultasi Spesifikasi &amp; Anggaran Laptop" inPartition="EAID_LANE_CUST"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_03" name="Sales Jalankan SPK SAW &amp; Simulasikan Tenor Kredit" inPartition="EAID_LANE_SALES"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_04" name="Sales Input Data Konsumen &amp; Buat Pesanan (Assisted Order)" inPartition="EAID_LANE_SALES"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_05" name="Sistem Terbitkan Pesanan Status PENDING (Invoice Sementara)" inPartition="EAID_LANE_SALES"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_06" name="Admin Menerima Notifikasi &amp; Cek Mutasi Bank / Leasing" inPartition="EAID_LANE_ADMIN"/>
          <node xmi:type="uml:DecisionNode" xmi:id="EAID_NODE_AC_07" name="Pembayaran / Leasing Sah &amp; Valid?" inPartition="EAID_LANE_ADMIN"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_08" name="Admin Verifikasi Pembayaran (Status Ubah Menjadi PAID)" inPartition="EAID_LANE_ADMIN"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_09" name="Stok Laptop Berkurang Otomatis di Gudang" inPartition="EAID_LANE_ADMIN"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_10" name="Faktur Lunas Terbit &amp; Komisi Sales Terakumulasi" inPartition="EAID_LANE_ADMIN"/>
          <node xmi:type="uml:OpaqueAction" xmi:id="EAID_NODE_AC_11" name="Admin Tolak Transaksi (Status CANCELLED / REJECTED)" inPartition="EAID_LANE_ADMIN"/>
          <node xmi:type="uml:ActivityFinalNode" xmi:id="EAID_NODE_AC_12" name="End" inPartition="EAID_LANE_ADMIN"/>
        </packagedElement>
      </packagedElement>

      <!-- ════════════════════════════════════════════════════════════════ -->
      <!-- 03. LOGICAL DATA MODEL (SINKRON 100% DENGAN GAMBAR 3.4)         -->
      <!-- ════════════════════════════════════════════════════════════════ -->
      <packagedElement xmi:type="uml:Package" xmi:id="EAID_PKG_CLS" name="03. Logical Data Model [Entity Classes]" visibility="public">
        
        <!-- 1. User -->
