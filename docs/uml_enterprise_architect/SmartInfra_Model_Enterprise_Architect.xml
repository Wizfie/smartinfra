          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_O10" name="+ isCredit : Boolean" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_O11" name="+ creditTenor : Integer" visibility="public"/>
