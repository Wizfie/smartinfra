          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_O14" name="+ financingProvider : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_O15" name="+ salesId : Integer [FK, Nullable]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_O16" name="+ paidAt : DateTime" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_O17" name="+ createdAt : DateTime" visibility="public"/>
        </packagedElement>

        <!-- 3. OrderItem (Junction Entity Order & Laptop) -->
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_CLS_ORDER_ITEM" name="OrderItem" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_OI1" name="+ id : Integer [PK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_OI2" name="+ orderId : Integer [FK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_OI3" name="+ laptopId : Integer [FK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_OI4" name="+ quantity : Integer" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_OI5" name="+ unitPrice : Decimal(15,2)" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_OI6" name="+ subtotal : Decimal(15,2)" visibility="public"/>
        </packagedElement>

        <!-- 4. Laptop -->
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_CLS_LAPTOP" name="Laptop" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L1" name="+ id : Integer [PK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L2" name="+ brand : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L3" name="+ model : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L4" name="+ sku : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L5" name="+ price : Decimal(15,2) [C1-Cost]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L6" name="+ stock : Integer" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L7" name="+ processorName : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L8" name="+ processorScore : Decimal(5,2) [C2-Ben]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L9" name="+ ramGb : Integer [C3-Ben]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L10" name="+ storageDesc : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L11" name="+ storageGb : Integer [C4-Ben]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L12" name="+ gpuName : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L13" name="+ gpuScore : Decimal(5,2) [C5-Ben]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L14" name="+ batteryHours : Decimal(4,1) [C6-Ben]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L15" name="+ weightKg : Decimal(4,2)" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L16" name="+ imageUrl : MediumText" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_L17" name="+ description : Text" visibility="public"/>
