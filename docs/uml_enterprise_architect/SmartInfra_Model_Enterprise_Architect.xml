          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_C1" name="+ id : Integer [PK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_C2" name="+ code : String(C1..C6)" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_C3" name="+ name : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_C4" name="+ type : String(cost, benefit)" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_C5" name="+ description : Text" visibility="public"/>
        </packagedElement>

        <!-- 6. LaptopCriteriaValue (Junction Entity Laptop & Criterion) -->
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_CLS_LAP_CRIT" name="LaptopCriteriaValue" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_LC1" name="+ id : Integer [PK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_LC2" name="+ laptopId : Integer [FK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_LC3" name="+ criterionId : Integer [FK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_LC4" name="+ rawValue : Decimal(12,2)" visibility="public"/>
        </packagedElement>

        <!-- 7. Profile (User Persona) -->
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_CLS_PROFILE" name="Profile" visibility="public">
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_P1" name="+ id : Integer [PK]" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_P2" name="+ name : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_P3" name="+ slug : String [Unique]" visibility="public"/>
