        </packagedElement>

        <!-- Associations dengan Multiplisitas Eksplisit (1, 0..*, 1..*, 6) -->
        <!-- 1. User -> Order (1 to 0..* Role: PIC Sales) -->
        <packagedElement xmi:type="uml:Association" xmi:id="EAID_ASC_USER_ORDER" name="PIC Sales" visibility="public">
          <memberEnd xmi:idref="EAID_ASC_UO_END1"/>
          <memberEnd xmi:idref="EAID_ASC_UO_END2"/>
          <ownedEnd xmi:type="uml:Property" xmi:id="EAID_ASC_UO_END1" type="EAID_CLS_USER" association="EAID_ASC_USER_ORDER">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_MULT_UO_L1" value="1"/>
            <upperValue xmi:type="uml:LiteralInteger" xmi:id="EAID_MULT_UO_U1" value="1"/>
          </ownedEnd>
          <ownedEnd xmi:type="uml:Property" xmi:id="EAID_ASC_UO_END2" type="EAID_CLS_ORDER" association="EAID_ASC_USER_ORDER">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_MULT_UO_L2" value="0"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_MULT_UO_U2" value="*"/>
          </ownedEnd>
        </packagedElement>

