          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_U3" name="+ passwordHash : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_U4" name="+ name : String" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_U5" name="+ role : Enum(admin, sales)" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="EAID_ATT_U6" name="+ createdAt : DateTime" visibility="public"/>
